{
  "manifest_version": 3,
  "name": "KAF AGC Third-Party Notice Checker",
  "short_name": "AGC IBL Checker",
  "version": "1.5.1",
  "description": "One-click check of AGC 'Notis Kepada Pihak Ketiga' (Act 613) notices. Extracts named parties from the PDF and appends them to the IBL and AGC Consolidated List workbooks, then opens the branch verification email as a Gmail draft.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Check AGC notices",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://lom.agc.gov.my/*",
    "https://mail.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}