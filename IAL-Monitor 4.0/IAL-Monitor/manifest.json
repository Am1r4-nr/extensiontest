{
  "manifest_version": 3,
  "name": "IAL Monitor - SC Investor Alert List",
  "short_name": "IAL Monitor",
  "version": "1.3.0",
  "description": "Checks the Securities Commission Malaysia Investor Alert List for new updates and exports them to Excel for KAF ID Screen.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://www.sc.com.my/*"],
  "content_scripts": [{ "matches": ["https://www.sc.com.my/investor-alert-list*"], "js": ["lib/hook.js"], "run_at": "document_start", "world": "MAIN" }],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "IAL Monitor", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
